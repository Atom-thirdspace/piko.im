SECRET_KEY=
OAUTH_REDIRECT_BASE=http://127.0.0.1:5000

#These are the credentials for the Google OAuth2.0 API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#These are the credentials for the Github OAuth API
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#These are the credentials for the Discord OAuth API
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

DATABASE_URL=

#Put emails for those who needs admin access
ADMIN_EMAILS=

#This key is for AI to guide throughout your learning journey, and to answers any of your questions
#You can use any of the AI api key, although this project uses AI key from https://ai.hackclub.com
HACKCLUB_AI_KEY=
HACKCLUB_AI_BASE=https://ai.hackclub.com/proxy/v1 #Change it to your base URL
TUTOR_MODEL=gpt-5-mini #Change it your favourite model
TUTOR_HOURLY_LIMIT=30

#A second passcode on top of ADMIN_EMAILS, asked for once per session.
#Generate the hash with: python scripts/admin_passcode.py
#Prefer the hash - ADMIN_PASSCODE keeps the passcode in plain text on disk.
ADMIN_PASSCODE_HASH=
ADMIN_PASSCODE=
#How long an unlock lasts before it is asked for again.
ADMIN_UNLOCK_MINUTES=120
