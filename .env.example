SECRET_KEY=
OAUTH_REDIRECT_BASE=http://127.0.0.1:5000

#These are the credentials for the Google OAuth2.0 API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#These are the credentials for the Github OAuth API
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#These are the credentials for the Discord OAuth API
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

DATABASE_URL=

#Put emails for those who needs admin access
ADMIN_EMAILS=

#This key is for AI to guide throughout your learning journey, and to answers any of your questions
#You can use any of the AI api key, although this project uses AI key from https://ai.hackclub.com
HACKCLUB_AI_KEY=
HACKCLUB_AI_BASE=https://ai.hackclub.com/proxy/v1 #Change it to your base URL
TUTOR_MODEL=gpt-5-mini #Change it your favourite model
TUTOR_HOURLY_LIMIT=30

#A second passcode on top of ADMIN_EMAILS, asked for once per session.
#Generate the hash with: python scripts/admin_passcode.py
#Prefer the hash - ADMIN_PASSCODE keeps the passcode in plain text on disk.
ADMIN_PASSCODE_HASH=
ADMIN_PASSCODE=
#How long an unlock lasts before it is asked for again.
ADMIN_UNLOCK_MINUTES=120
#Encrypts TOTP secrets at rest, so a database dump alone can't mint 2FA codes.
#Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#Back it up separately from the database - losing it forces every 2FA user
#onto their backup codes.
TOTP_ENC_KEY=
# RP_ID is the bare domain - no scheme, no port, and never an IP
# address. ORIGIN is scheme+host+port exactly as it appears in the
# URL bar. A mismatch fails every ceremony with an opaque error.

#This is to enable the security key feature so that user can authenticate without the use of password
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Piko
WEBAUTHN_ORIGIN=http://localhost:5055

#To setup the billing for subscriptions (refer https://polar.sh)
POLAR_ACCESS_TOKEN=
POLAR_SANDBOX=1
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_MONTHLY=      #(for monthly subscription)
POLAR_PRODUCT_YEARLY=       #(for yearly subscription)
POLAR_PRODUCT_CLASSROOM=     #(for educational subscription)